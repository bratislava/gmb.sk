{
  "name": "city-gallery-next",
  "version": "1.1.1",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "dev": "next dev",
    "develop": "next dev",
    "build": "next build",
    "start": "next start",
    "gen": "graphql-codegen && prettier --write src/services/graphql/index.ts",
    "lint": "eslint src",
    "lint:quiet": "npm run lint -- --quiet",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier --write .",
    "parse-translations": "i18next-cli extract",
    "update-i18next": "npm install next-i18next@latest react-i18next@latest i18next@latest --save-exact && npm install i18next-cli@latest --save-dev --save-exact",
    "update-markdown": "npm install react-markdown@latest remark-gfm@latest && npm install --save-dev --save-exact",
    "update-next": "npm install next@latest react@latest react-dom@latest sharp@latest --save-exact && npm install @types/react@latest @types/react-dom@latest typescript@latest --save-dev --save-exact",
    "update-react-aria": "npm install @internationalized/date@latest @react-stately/utils@latest react-aria@latest react-aria-components@latest react-stately@latest tailwindcss-react-aria-components@1 --save-exact",
    "update-tailwind": "npm install tailwind-merge@latest clsx@latest --save-exact && npm install tailwindcss@latest postcss@latest prettier-plugin-tailwindcss@latest --save-dev --save-exact",
    "update-prettier": "npm install prettier@latest eslint-config-prettier@latest eslint-plugin-prettier@latest --save-dev --save-exact",
    "update-graphql": "npm install graphql@latest graphql-request@6 graphql-tag@latest --save-exact && npm install @graphql-codegen/cli@latest @graphql-codegen/typescript@latest @graphql-codegen/typescript-operations@latest @graphql-codegen/typescript-graphql-request@latest --save-dev --save-exact",
    "update-react-query": "npm install @tanstack/react-query@latest --save-exact",
    "update-mapbox": "npm install react-map-gl@latest mapbox-gl@latest --save-exact",
    "update-typescript": "npm install typescript@latest --save-dev --save-exact"
  },
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "3.0.80",
    "@react-stately/toggle": "3.10.1",
    "@react-types/checkbox": "3.11.0",
    "@tanstack/react-query": "5.101.0",
    "@types/mailchimp__mailchimp_marketing": "3.0.21",
    "clsx": "2.1.1",
    "graphql": "16.14.1",
    "graphql-request": "7.4.0",
    "graphql-tag": "2.12.6",
    "gsap": "3.12.7",
    "html-react-parser": "5.2.2",
    "i18next": "26.3.1",
    "lodash": "4.18.1",
    "mapbox-gl": "3.24.0",
    "meilisearch": "0.32.4",
    "next": "16.2.7",
    "next-i18next": "16.0.7",
    "nuqs": "2.8.9",
    "pretty-bytes": "6.1.1",
    "react": "19.2.7",
    "react-aria": "3.49.0",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.8",
    "react-image-gallery": "1.4.0",
    "react-map-gl": "8.1.1",
    "react-markdown": "10.1.0",
    "react-modal": "3.16.3",
    "remark-gfm": "4.0.1",
    "remark-supersub": "1.0.0",
    "sharp": "0.35.0",
    "slugify": "1.6.6",
    "swiper": "12.2.0",
    "tailwind-merge": "3.6.0",
    "tailwind-scrollbar-hide": "4.0.0",
    "tailwindcss-react-aria-components": "2.1.1",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@bratislava/eslint-config-next": "0.15.0",
    "@graphql-codegen/cli": "5.0.5",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-graphql-request": "6.2.1",
    "@graphql-codegen/typescript-operations": "4.6.0",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/lodash": "4.17.24",
    "@types/node": "24.13.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-image-gallery": "1.2.4",
    "@types/react-mailchimp-subscribe": "2.1.4",
    "@types/react-modal": "3.16.3",
    "eslint": "9.39.1",
    "i18next-cli": "1.61.0",
    "postcss": "8.5.23",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.16.x",
    "npm": ">=11.13.x"
  },
  "volta": {
    "node": "24.16.0",
    "npm": "11.13.0"
  }
}
