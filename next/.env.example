# To start developing, copy this into .env.local

NEXT_PUBLIC_DEPLOYMENT=dev
NEXT_PUBLIC_NEXT_URL=http://localhost:3000

# Local Strapi (see strapi/README.md)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Alternative: run against the deployed Strapi
# NEXT_PUBLIC_STRAPI_URL=https://city-gallery-strapi.staging.bratislava.sk

# Must match REVALIDATE_SECRET_TOKEN in strapi/.env.local
REVALIDATE_SECRET_TOKEN=<see-readme>

# Meilisearch — use "Default Search API Key", see the Meilisearch section in the root README.md
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_API_KEY=<see-readme>
# Alternative: run against the deployed Meilisearch
# NEXT_PUBLIC_MEILISEARCH_HOST=https://city-gallery-strapi-meilisearch.staging.bratislava.sk
# NEXT_PUBLIC_MEILISEARCH_SEARCH_API_KEY=4bbe927f83cacb443278f4c064fd579875427eca794e7bc54ce1b278d8212664

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiYnJhdGlzbGF2YTAxIiwiYSI6ImNreWp4d3RmbDJxdHcyb24wcTRzODV1Z2oifQ.ted1x1pbp8w3jZG0MygBUw

# Google Analytics — keep the fake id unless you need to test the tracking locally
NEXT_PUBLIC_GOOGLE_ANALYTICS_TRACKING_ID=fake-id

# Newsletter
MAILCHIMP_API_KEY=<contact-PM-if-needed>
MAILCHIMP_API_SERVER=us3
MAILCHIMP_AUDIENCE_ID=e18d8cb372
